# VitalIQ Configuration
# Copy this file to .env and fill in your values

# Anthropic API key for Claude-powered AI analysis (optional)
# Without this, VitalIQ uses the rule-based engine
ANTHROPIC_API_KEY=your_key_here

# Database path (default: backend/health_data/vitaliq.db)
# DATABASE_PATH=./health_data/vitaliq.db
